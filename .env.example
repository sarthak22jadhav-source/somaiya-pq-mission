# ---------------------------------------------------------------------------
# SomaiyaSat & SomaiyaPod - PocketQube Mission Dashboard
# Copy this file to ".env" and fill in the values for your environment:
#
#     copy .env.example .env
#
# The dashboard connects to Supabase PostgreSQL through DATABASE_URL. There is
# NO automatic SQLite fallback: if DATABASE_URL is missing or the connection
# fails, the app stops at startup with a clear error.
#
# IMPORTANT: percent-encode reserved characters in the password. A literal "@"
# makes libpq treat the rest of the string as the host name. Use %40 for "@".
# ---------------------------------------------------------------------------

# ---- Supabase PostgreSQL ----------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (select the "URI" format). Copy the URL and percent-encode the password.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Example with a password containing "@" (encoded as %40):
#   DATABASE_URL=postgresql://postgres.your-project-ref:my%40password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:Sarthak%402007@db.tpsjdbkivdqjfuhlwpvz.supabase.co:5432/postgres

# Optional: seconds to wait for the connection handshake (default 10).
DB_CONNECT_TIMEOUT=10

# ---- Flask ----------------------------------------------------------------
FLASK_SECRET_KEY=somaiya_sat_secret_key_987654321
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set to 1 for the auto-reloading development server.
FLASK_DEBUG=1
